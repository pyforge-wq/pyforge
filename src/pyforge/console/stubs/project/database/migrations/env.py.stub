"""Alembic environment script, run by `pyforge migrate`/`migrate:make`/etc.

Resolves the database connection the same way the running application does
(via DatabaseManager built from config/database.py) rather than duplicating
a URL in a separate alembic.ini — one source of truth for the connection.
"""

from pathlib import Path

from pyforge.config import Config
from pyforge.database import DatabaseManager
from pyforge.database.migrations import run_migrations
from pyforge.orm import Base

# Import your model modules here (or from app/models/__init__.py) so
# Base.metadata sees them — only needed if you ever run `alembic
# revision --autogenerate` directly; `pyforge migrate:make`'s Schema-DSL
# migrations don't need it.
# import app.models  # noqa: F401

BASE_PATH = Path(__file__).resolve().parents[2]
project_config = Config.load_directory(BASE_PATH / "config")
database = DatabaseManager(project_config.get("database"))

run_migrations(database.engine(), Base.metadata)
