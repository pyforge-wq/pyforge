from pyforge import env

# Used by pyforge.storage.make_storage() — an optional module (pip install
# pyforge-framework[storage] for the s3 driver, which also covers R2 and
# other S3-compatible stores).
config = {
    "default": env("STORAGE_DRIVER", "local"),
    "root": env("STORAGE_ROOT", "storage/app"),
    "base_url": env("STORAGE_BASE_URL", "/storage"),
    "bucket": env("STORAGE_S3_BUCKET", None),
    "region": env("STORAGE_S3_REGION", None),
    "endpoint_url": env("STORAGE_S3_ENDPOINT_URL", None),
    "access_key_id": env("STORAGE_S3_ACCESS_KEY_ID", None),
    "secret_access_key": env("STORAGE_S3_SECRET_ACCESS_KEY", None),
}
