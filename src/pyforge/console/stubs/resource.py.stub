from typing import Any

from pyforge import Resource


class {{ class_name }}(Resource):
    """Generated by `pyforge make:resource`.

        {{ class_name }}.make(model)          # -> dict
        {{ class_name }}.collection(models)   # -> list[dict]
        {{ class_name }}.paginated(paginator) # -> {"data": [...], "meta": {...}}
    """

    def to_dict(self, model: Any) -> dict:
        return {
            "id": model.id,
        }
